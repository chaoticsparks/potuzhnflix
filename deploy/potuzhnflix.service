# potuzhnflix.service — template; setup-pi.sh fills in @USER@, @DIR@ and @CACHE@
[Unit]
Description=ПотужнFLIX TV box
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=/usr/bin/node server/index.js --pi
Restart=always
RestartSec=3

# The remote at http://tvbox.local (port 80 without running as root)
Environment=PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=TVBOX_URL=http://tvbox.local
# Downloads: the USB drive once it's mounted; /tmp is RAM on Debian 13, never use it
Environment=TVBOX_CACHE=@CACHE@
Environment=LOG_LEVEL=info

# mpv draws straight to HDMI (DRM/KMS) and plays sound over HDMI
SupplementaryGroups=video render audio

[Install]
WantedBy=multi-user.target
